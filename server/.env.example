# Copiá este archivo a .env y completalo. El .env NUNCA va a git.

# Base de desarrollo (PostgreSQL). Si la contraseña tiene símbolos, codificala
# para URL (por ejemplo @ → %40).
DATABASE_URL=postgresql://sapsa_app:CAMBIAR@localhost:5432/sapsa_dev

# Dirección del front. Si son varias, separalas con coma.
# Vacía: en Render, la dirección del servicio; si no, http://localhost:5173.
CLIENT_URL=http://localhost:5173

# Carpeta del front compilado que sirve la API. Vacía = ../client/dist.
# En desarrollo no hace falta: el front lo sirve Vite.
FRONT_DIR=
PORT=4000

# Detrás de un proxy (IIS, nginx...), cuántos saltos hay hasta la API (casi
# siempre 1), para que la IP de la auditoría y del límite de intentos sea la
# real. Vacío = la API recibe las conexiones directo.
TRUST_PROXY=

# --- Sesiones ---
# Se cierra sola después de este tiempo sin usar la app...
SESION_INACTIVIDAD_MINUTOS=30
# ...y siempre a las tantas horas de haber entrado, aunque se esté usando.
SESION_MAXIMA_HORAS=8

# --- Intentos de login ---
# Después de tantos intentos fallidos seguidos, la cuenta queda bloqueada un rato.
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15
# Logins fallidos permitidos por IP cada 15 minutos (sin importar el usuario).
# Si toda la oficina sale a internet por la misma IP, comparten este límite.
LOGIN_MAX_FALLOS_POR_IP=100

# --- Seed (npm run db:seed) ---
# Superadministrador. Si ya existe, el seed no le cambia la contraseña.
# Usuario: minúsculas, números, punto, guion o guion bajo.
# Contraseña: de 10 a 72 caracteres (las letras con tilde y la ñ cuentan doble).
SUPERADMIN_USUARIO=
SUPERADMIN_NOMBRE=
SUPERADMIN_PASSWORD=
# Opcional.
SUPERADMIN_EMAIL=

# Contraseña de TODOS los usuarios ficticios de ejemplo (admin.demo,
# solicitante.demo, ...). Vacía = no se crean. En producción no se crean nunca.
SEED_PASSWORD_EJEMPLO=

# --- Claude (Anthropic) ---
# La clave de la API de Anthropic (console.anthropic.com). La usan el asistente
# (docs/superpowers/specs/2026-11-27-asistente-design.md) y el respaldo de los
# precios de INAC. Vacía = el asistente dice "no está configurado".
ANTHROPIC_API_KEY=
# Opcional: el modelo del asistente. Vacío = claude-haiku-5-5.
ASISTENTE_MODELO=
